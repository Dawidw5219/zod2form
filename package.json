{
  "name": "zod2form",
  "version": "2.1.5",
  "description": "Your Zod schema is your form. No boilerplate.",
  "private": false,
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "zod",
    "form",
    "react",
    "react-hook-form",
    "schema",
    "validation",
    "typescript"
  ],
  "homepage": "https://github.com/Dawidw5219/zod2form",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dawidw5219/zod2form.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "source": "./src/index.ts",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p example/tsconfig.json",
    "build": "bun run typecheck && bun run test && tsdown && vite build example --base /zod2form/",
    "test": "vitest run",
    "demo": "vite example",
    "deploy": "bun run build && bun run check:package && ghdeploy --npm --pages example/dist",
    "check:package": "publint"
  },
  "dependencies": {
    "react-hook-form": "^7.0.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "zod": ">=3.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "highlight.js": "^11.12.0",
    "jsdom": "^26.0.0",
    "publint": "^0.3.18",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsdown": "^0.21.7",
    "typescript": "^5.9.3",
    "vite": "^8.0.5",
    "vitest": "^4.1.2",
    "zod": "^4.3.6"
  },
  "packageManager": "bun@1.4.4"
}
